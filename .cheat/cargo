#   main today:    CSort | NativeSort
#   pending PR #8: CSort | StableSort (timsort) | UnstableSort (pdqsort)
cargo test test_both_agree       # renamed to test_all_agree in PR #8

# Prove the monomorphization claim (cargo-asm is NOT in shell.nix)
cargo asm --lib 'aoc_ffi_day01::solve'

# Watch loop -- the .vscode "Watch" task
bacon test
