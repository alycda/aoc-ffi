---
syntax: bash
tags: [ aoc-ffi, uniffi, bindings ]
---
# Bindings embed a PLATFORM-SPECIFIC library. Switching macOS <-> devcontainer?
# Regenerate. Always.
just clean-bindings && just uniffi-gen-all

# Generate one language
just uniffi-gen-python
just uniffi-gen-kotlin
just uniffi-gen-swift      # implies build-lib-no-glib

# Test
just uniffi-test           # python + kotlin
just uniffi-test-all       # + swift (macOS native; skipped on Linux+Nix today)

# ---------------------------------------------------------------------------
# INSPECT WHAT WAS ACTUALLY GENERATED. Generated code is the source of truth,
# not your assumptions. Names get transformed and errors get renamed:
#   uniffi_process_rust_sort  ->  uniffiProcessRustSort   (kotlin, swift)
#   AocError                  ->  AocException            (kotlin)
# ---------------------------------------------------------------------------
grep '^fun uniffi\|^class Aoc' \
    aoc-2024-12-01/bindings/kotlin/uniffi/aoc_ffi_day01/aoc_ffi_day01.kt
jar tf aoc-2024-12-01/bindings/kotlin/aoc_ffi_day01.jar | grep -i 'process\|aocerror'
grep '^public func\|^public enum' aoc-2024-12-01/bindings/swift/aoc_ffi_day01.swift
(cd aoc-2024-12-01 && PYTHONPATH=bindings/python python3 -c \
    "import aoc_ffi_day01 as m; print([n for n in dir(m) if 'process' in n])")

# ---------------------------------------------------------------------------
# Gotchas
# ---------------------------------------------------------------------------
# Version must match the uniffi crate in Cargo.toml, or scaffolding errors are cryptic
uniffi-bindgen --version          # expect 0.28.3

# Swift build excludes GLib -> uniffiProcessPart2Glib is NOT available there
just build-lib-no-glib

# Exported fns take owned String (not &str) and return Result<_, AocError>.
# The .udl is deliberately near-empty; everything is #[uniffi::export] proc-macros.
cat aoc-2024-12-01/src/aoc_ffi_day01.udl

# Scaffolding is regenerated by build.rs on .udl / .c / .h change
touch aoc-2024-12-01/src/aoc_ffi_day01.udl && just build-lib
